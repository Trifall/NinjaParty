{
	"name": "svelte-starter",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "NODE_ENV=production bunx --bun vite build",
		"start": "NODE_ENV=production bun run build/index.js",
		"preview": "bunx --bun vite preview",
		"prepare": "husky && svelte-kit sync || echo ''",
		"test": "bunx --bun vitest run",
		"check": "svelte-kit sync && svelte-check --workspace ./ --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --workspace ./ --tsconfig ./tsconfig.json --watch",
		"format": "prettier -c --ignore-path .gitignore --log-level warn \"./**/*.{js,jsx,ts,tsx,svelte,css,json}\" ",
		"format:fix": "prettier --ignore-path .gitignore --log-level warn --write \"./**/*.{js,jsx,ts,tsx,svelte,css,json}\" ",
		"lint": "oxlint ./src && eslint \"./src/**/*.svelte\" --cache",
		"lint:fix": "oxlint ./src --fix && eslint \"./src/**/*.svelte\" --cache --fix",
		"lint:oxlint": "oxlint ./src",
		"lint:eslint": "eslint \"./src/**/*.svelte\" --cache",
		"fullcheck": "bun run test && bun run check && bun run lint:fix && bun run format:fix && bun run build",
		"update-packages": "bun update"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"@types/bcrypt": "^6.0.0",
		"@types/eslint": "^9.6.1",
		"bun-types": "^1.3.9",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-oxlint": "^1.43.0",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"oxlint": "^1.43.0",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "0.7.1",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@fontsource/roboto": "^5.2.9",
		"@lucide/svelte": "^0.563.1",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/enhanced-img": "^0.10.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tanstack/table-core": "^8.21.3",
		"autoprefixer": "^10.4.24",
		"bits-ui": "1.5.2",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"motion": "^12.31.0",
		"rate-limiter-flexible": "^8.3.0",
		"runed": "^0.37.1",
		"svelte": "5.49.2",
		"svelte-meta-tags": "^4.5.0",
		"svelte-sonner": "^1.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^3.4.18",
		"tailwindcss-animate": "^1.0.7",
		"tippy.js": "^6.3.7",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "7.3.1",
		"winston": "^3.19.0",
		"zod": "^4.3.6"
	},
	"engines": {
		"node": "^22.0.0"
	},
	"packageManager": "bun@1.3.9"
}
