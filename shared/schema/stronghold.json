{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RoomMessage",
  "description": "Canonical message schema for Ninjabrain Bot Cloud Relay. The payload always contains full state, not diffs.",
  "type": "object",
  "required": ["type", "ts", "source", "runnerName", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["stronghold_update", "presence", "boat_update", "blind_update", "divine_update", "all_advancements_update", "information_messages_update", "room_closed"],
      "description": "Message type. stronghold_update contains triangulation data. presence indicates runner online/offline status."
    },
    "ts": {
      "type": "integer",
      "description": "Unix timestamp in milliseconds"
    },
    "source": {
      "type": "string",
      "description": "Source identifier, e.g. 'ninjabrain-local'"
    },
    "runnerName": {
      "type": "string",
      "description": "The display name of the runner (max 24 chars)"
    },
    "payload": {
      "oneOf": [
        { "$ref": "#/definitions/StrongholdPayload" },
        { "$ref": "#/definitions/PresencePayload" },
        { "$ref": "#/definitions/BoatPayload" },
        { "$ref": "#/definitions/BlindPayload" },
        { "$ref": "#/definitions/DivinePayload" },
        { "$ref": "#/definitions/AllAdvancementsPayload" },
        { "$ref": "#/definitions/InformationMessagesPayload" },
        { "$ref": "#/definitions/RoomClosedPayload" }
      ]
    }
  },
  "definitions": {
    "StrongholdPayload": {
      "type": "object",
      "required": ["resultType", "playerPosition", "eyeThrows"],
      "properties": {
        "resultType": {
          "type": "string",
          "enum": ["NONE", "TRIANGULATION", "FAILED", "BLIND", "DIVINE", "ALL_ADVANCEMENTS"],
          "description": "Type of stronghold calculation result"
        },
        "playerPosition": { "$ref": "#/definitions/PlayerPosition" },
        "eyeThrows": {
          "type": "array",
          "items": { "$ref": "#/definitions/EyeThrow" }
        },
        "predictions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ChunkPrediction" },
          "description": "Chunk predictions sorted by certainty"
        }
      }
    },
    "PresencePayload": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["online", "offline"]
        },
        "name": {
          "type": "string",
          "description": "Optional display name for the runner"
        }
      }
    },
    "BoatPayload": {
      "type": "object",
      "required": ["boatState"],
      "properties": {
        "boatAngle": {
          "type": ["number", "null"]
        },
        "boatState": {
          "type": "string",
          "enum": ["NONE", "ERROR", "MEASURING", "VALID"]
        }
      }
    },
    "BlindPayload": {
      "type": "object",
      "required": ["isBlindModeEnabled", "hasDivine", "blindResult"],
      "properties": {
        "isBlindModeEnabled": { "type": "boolean" },
        "hasDivine": { "type": "boolean" },
        "blindResult": {
          "oneOf": [
            { "$ref": "#/definitions/BlindResult" },
            { "type": "object" }
          ]
        }
      }
    },
    "BlindResult": {
      "type": "object",
      "required": ["xInNether", "zInNether", "highrollProbability", "highrollThreshold", "averageDistance", "improveDirection", "improveDistance", "evaluation"],
      "properties": {
        "xInNether": { "type": "number" },
        "zInNether": { "type": "number" },
        "highrollProbability": { "type": "number" },
        "highrollThreshold": { "type": "number" },
        "averageDistance": { "type": "number" },
        "improveDirection": { "type": "number" },
        "improveDistance": { "type": "number" },
        "evaluation": {
          "type": "string",
          "enum": ["EXCELLENT", "HIGHROLL_GOOD", "HIGHROLL_OKAY", "BAD_BUT_IN_RING", "BAD", "NOT_IN_RING"]
        }
      }
    },
    "DivinePayload": {
      "type": "object",
      "required": ["isDivineModeEnabled", "divineResult"],
      "properties": {
        "isDivineModeEnabled": { "type": "boolean" },
        "divineResult": {
          "oneOf": [
            { "$ref": "#/definitions/DivineResult" },
            { "type": "object" }
          ]
        }
      }
    },
    "DivineResult": {
      "type": "object",
      "required": ["fossilXCoordinate", "formattedHighrollCoords", "formattedSafeCoords"],
      "properties": {
        "fossilXCoordinate": { "type": "number" },
        "formattedHighrollCoords": { "type": "string" },
        "formattedSafeCoords": { "type": "string" }
      }
    },
    "AllAdvancementsPayload": {
      "type": "object",
      "required": ["isAllAdvancementsModeEnabled"],
      "properties": {
        "isAllAdvancementsModeEnabled": { "type": "boolean" },
        "spawn": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        },
        "outpost": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        },
        "monument": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        },
        "stronghold": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        },
        "deepDark": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        },
        "cityQuery": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        },
        "shulkerTransport": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        },
        "generalLocation": {
          "oneOf": [
            { "$ref": "#/definitions/StructurePosition" },
            { "type": "object" }
          ]
        }
      }
    },
    "StructurePosition": {
      "type": "object",
      "properties": {
        "xInOverworld": { "type": "number" },
        "zInOverworld": { "type": "number" },
        "overworldDistance": { "type": "number" },
        "travelAngle": { "type": "number" }
      }
    },
    "InformationMessagesPayload": {
      "type": "object",
      "properties": {
        "informationMessages": {
          "type": "array",
          "items": { "$ref": "#/definitions/InformationMessage" }
        }
      }
    },
    "InformationMessage": {
      "type": "object",
      "required": ["severity", "type", "message"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["INFO", "WARNING", "ERROR"]
        },
        "type": {
          "type": "string",
          "enum": ["PORTAL_LINKING", "NEXT_THROW_DIRECTION", "MISMEASURE", "MC_VERSION", "COMBINED_CERTAINTY"]
        },
        "message": { "type": "string" }
      }
    },
    "RoomClosedPayload": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string" }
      }
    },
    "PlayerPosition": {
      "type": "object",
      "required": ["xInOverworld", "zInOverworld", "isInOverworld", "horizontalAngle"],
      "properties": {
        "xInOverworld": { "type": "number" },
        "zInOverworld": { "type": "number" },
        "isInOverworld": { "type": "boolean" },
        "isInNether": { "type": "boolean" },
        "horizontalAngle": { "type": "number" }
      }
    },
    "EyeThrow": {
      "type": "object",
      "required": ["xInOverworld", "zInOverworld", "angle", "error", "type"],
      "properties": {
        "xInOverworld": { "type": "number" },
        "zInOverworld": { "type": "number" },
        "angle": { "type": "number" },
        "angleWithoutCorrection": { "type": "number" },
        "correction": { "type": "number" },
        "correctionIncrements": { "type": "integer" },
        "error": { "type": "number" },
        "type": {
          "type": "string",
          "enum": ["NORMAL", "NORMAL_WITH_ALT_STD", "MANUAL", "BOAT"]
        }
      }
    },
    "ChunkPrediction": {
      "type": "object",
      "required": ["certainty", "chunkX", "chunkZ", "overworldDistance"],
      "properties": {
        "certainty": { "type": "number", "minimum": 0, "maximum": 1 },
        "chunkX": { "type": "integer" },
        "chunkZ": { "type": "integer" },
        "overworldDistance": { "type": "number" }
      }
    }
  }
}
